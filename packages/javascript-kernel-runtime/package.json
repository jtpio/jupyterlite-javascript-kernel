{
  "name": "@jupyterlite/javascript-kernel-runtime",
  "version": "0.4.0-alpha.5",
  "description": "JupyterLite - JavaScript Kernel Runtime",
  "homepage": "https://github.com/jupyterlite/javascript-kernel",
  "bugs": {
    "url": "https://github.com/jupyterlite/javascript-kernel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jupyterlite/javascript-kernel.git"
  },
  "license": "BSD-3-Clause",
  "author": "JupyterLite Contributors",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "unpkg": "dist/javascript-kernel-runtime.umd.min.js",
  "jsdelivr": "dist/javascript-kernel-runtime.umd.min.js",
  "directories": {
    "lib": "lib/"
  },
  "files": [
    "dist/*",
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "src/**/*.{ts,tsx}",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "jlpm build:lib && jlpm build:bundle",
    "build:bundle": "node scripts/bundle.mjs",
    "build:lib": "tsc -b",
    "build:prod": "jlpm build",
    "clean": "rimraf lib dist tsconfig.tsbuildinfo",
    "prepublishOnly": "npm run build",
    "watch": "tsc -b --watch"
  },
  "dependencies": {
    "@jupyterlab/nbformat": "^4.6.0",
    "@jupyterlab/services": "^7.6.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "astring": "^1.9.0"
  },
  "devDependencies": {
    "@rspack/core": "^2.2.5",
    "rimraf": "~5.0.1",
    "typescript": "~5.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
