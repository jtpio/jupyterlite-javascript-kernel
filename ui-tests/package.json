{
  "name": "@jupyterlite/javascript-kernel-ui-tests",
  "version": "1.0.0",
  "description": "JupyterLite JavaScript kernel integration tests",
  "private": true,
  "scripts": {
    "build": "jlpm run clean && python build.py",
    "clean": "rimraf dist .jupyterlite.doit.db",
    "start": "python -m http.server -b 127.0.0.1 8000 --directory dist",
    "test": "playwright test",
    "test:debug": "PWDEBUG=1 playwright test",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@jupyterlab/galata": "~5.6.4",
    "@playwright/test": "^1.64.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.1"
  }
}
